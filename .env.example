# Copy to .env (never commit .env). Every value is read lazily, at first use, never at import.
# Environment to run against (a key of client-pack/config/client.config.ts environments)
QIP_ENV=demo

# Who holds the session lock for this run (an agent or person name)
QIP_INSTANCE=local

# UI roles (one pair per role in client.config.ts)
QIP_ADMIN_USER=admin
QIP_ADMIN_PASS=demo-pass
QIP_VIEWER_USER=viewer
QIP_VIEWER_PASS=demo-pass

# API auth (pick the variables your api auth kind needs)
QIP_API_TOKEN_URL=
QIP_API_CLIENT_ID=
QIP_API_CLIENT_SECRET=
QIP_API_KEY=demo-api-key
